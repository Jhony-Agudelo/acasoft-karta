  branch_id              String   @db.Uuid
  expense_id             String   @db.Uuid
  method                 String   @db.VarChar(20) // CASH | POS_TERMINAL | MANUAL_TRANSFER
  amount_cop             Int
  cash_shift_movement_id String?  @db.Uuid
  reference_note         String?  @db.VarChar(255)
  status                 String   @default("APPROVED") @db.VarChar(20) // APPROVED | VOIDED
  created_by             String   @db.Uuid
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  tenant              Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch              Branch             @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  expense             ExpenseDocument    @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  cash_shift_movement CashShiftMovement? @relation(fields: [cash_shift_movement_id], references: [id], onDelete: SetNull)
  creator             User               @relation("ExpensePaymentCreator", fields: [created_by], references: [id])

  @@map("expense_payments")
}

model ReceivedSupplierInvoice {
  id                         String    @id @default(uuid()) @db.Uuid
  tenant_id                  String    @db.Uuid
  branch_id                  String    @db.Uuid
  factus_reception_id        String    @db.VarChar(64)
  track_id_or_cufe           String    @db.VarChar(128)
  invoice_number             String    @db.VarChar(64)
  supplier_nit               String    @db.VarChar(32)
  supplier_name              String    @db.VarChar(255)
  issue_date                 DateTime  @db.Date
  total_cop                  Int
  event_030_emitted_at       DateTime? @db.Timestamptz(6)
  event_032_emitted_at       DateTime? @db.Timestamptz(6)
  event_033_or_034_emitted_at DateTime? @db.Timestamptz(6)
  completed_events           Boolean   @default(false)
  created_at                 DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime  @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, track_id_or_cufe], name: "uq_received_supplier_invoices_cufe")
  @@map("received_supplier_invoices")
}

model EmployeeProfile {
  id                           String    @id @default(uuid()) @db.Uuid
  tenant_id                    String    @db.Uuid
  branch_id                    String    @db.Uuid
  user_id                      String?   @unique @db.Uuid // Nullable para soportar personal de aseo/limpieza, logística, etc. sin login
  employee_code                String    @db.VarChar(32)
  job_title                    String    @db.VarChar(100)
  department                   String?   @db.VarChar(100)
  has_system_access            Boolean   @default(false)
  identification_document_code String    @default("13") @db.VarChar(4)
  identification_number        String    @db.VarChar(32)
  first_name                   String    @db.VarChar(100)
  first_surname                String    @db.VarChar(100)
  second_surname               String?   @db.VarChar(100)
  address                      String    @db.VarChar(255)
  municipality_code            String    @default("66400") @db.VarChar(10)
  email                        String?   @db.VarChar(255)
  phone                        String?   @db.VarChar(32)
  worker_type_code             String    @default("01") @db.VarChar(4)
  worker_subtype               String    @default("00") @db.VarChar(4)
  contract_type                String    @default("1") @db.VarChar(4)
  has_integral_salary          Boolean   @default(false)
  has_high_risk                Boolean   @default(false)
  base_salary_cop              Int
  receives_transport_allowance Boolean   @default(true)
  entry_date                   DateTime  @db.Date
  retirement_date              DateTime? @db.Date
  payment_method_code          String    @default("42") @db.VarChar(4)
  bank_name                    String?   @db.VarChar(100)
  account_type                 String?   @db.VarChar(4)
  account_number               String?   @db.VarChar(64)
  is_active                    Boolean   @default(true)
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime  @updatedAt @db.Timestamptz(6)

  tenant              Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch              Branch              @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  user                User?               @relation(fields: [user_id], references: [id], onDelete: SetNull)
  payroll_settlements PayrollSettlement[]

  @@unique([tenant_id, identification_number], name: "uq_employee_profiles_tenant_ident")
  @@map("employee_profiles")
}

model PayrollSettlement {
  id                           String    @id @default(uuid()) @db.Uuid
  tenant_id                    String    @db.Uuid
  branch_id                    String    @db.Uuid
  employee_id                  String    @db.Uuid
  reference_code               String    @db.VarChar(64)
  year                         Int
  month                        Int
  payroll_period_code          String    @default("5") @db.VarChar(4)
  days_worked                  Int
  worked_salary_cop            Int
  transport_allowance_cop      Int       @default(0)
  commissions_cop              Int       @default(0)
  overtime_and_surcharges_json Json      @default("[]") @db.JsonB
  overtime_total_cop           Int       @default(0)
  health_deduction_cop         Int
  pension_deduction_cop        Int
  other_deductions_cop         Int       @default(0)
  gross_accrued_cop            Int
  total_deductions_cop         Int
  net_payable_cop              Int
  payment_date                 DateTime  @db.Date
  status                       String    @default("DRAFT") @db.VarChar(32) // DRAFT | VALIDATED_DIAN | REJECTED_DIAN | ANNULLED_BY_ADJUSTMENT
  factus_payroll_number        String?   @db.VarChar(64) // ej. 'NEF110'
  cune                         String?   @db.VarChar(128)
  pdf_url                      String?   @db.Text
  xml_url                      String?   @db.Text
  response_payload_json        Json?     @db.JsonB
  last_error_message           String?   @db.Text
  created_by                   String    @db.Uuid
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch   Branch          @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  employee EmployeeProfile @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  creator  User            @relation("PayrollCreator", fields: [created_by], references: [id])

  @@unique([tenant_id, reference_code], name: "uq_payroll_settlements_reference")
  @@index([tenant_id, branch_id, status], name: "idx_payroll_settlements_status")
  @@map("payroll_settlements")
}




