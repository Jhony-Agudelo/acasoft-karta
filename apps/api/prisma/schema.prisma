// Prisma Schema para Restaurante SaaS
// Alineado con DEFINICION_TECNICA.md (v2.4.0) y FASE_01_FUNDACION_Y_NUCLEO_SAAS.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. TENANCY, MARCA Y SUCURSALES
// -----------------------------------------------------------------------------

model Tenant {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  slug                String   @unique
  status              String   @default("ACTIVE") // ACTIVE | SUSPENDED
  plan_id             String   @default("PLAN_STARTER_WHATSAPP")
  tax_profile_mode    String   @default("FINAL_PRICE_NO_BREAKDOWN") // FINAL_PRICE_NO_BREAKDOWN | TAX_INCLUDED_DISCRIMINATED | BASE_PLUS_TAX
  default_tax_type    String   @default("NONE") // NONE | INC | IVA | EXEMPT
  default_tax_rate_bp Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz

  brand_settings   BrandSettings?
  branches         Branch[]
  memberships      Membership[]
  module_settings  TenantModuleSetting[]
  channel_policies BranchChannelPolicy[]
  audit_events     AuditEvent[]
  menus            Menu[]
  categories       Category[]
  products         Product[]
  product_variants ProductVariant[]
  modifier_groups        ModifierGroup[]
  modifier_options       ModifierOption[]
  qr_code_links          QrCodeLink[]
  customers              Customer[]
  delivery_zones         DeliveryZone[]
  delivery_addresses     DeliveryAddress[]
  branch_order_sequences BranchOrderSequence[]
  orders                 Order[]
  order_items            OrderItem[]
  order_status_events    OrderStatusEvent[]

  @@map("tenants")
}

model BrandSettings {
  tenant_id       String   @id @db.Uuid
  logo_url        String?
  primary_color   String   @default("#E11D48")
  secondary_color String   @default("#1E293B")
  cover_url       String?
  description     String?
  public_domain   String?  @unique

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("brand_settings")
}

model Branch {
  id                   String   @id @default(uuid()) @db.Uuid
  tenant_id            String   @db.Uuid
  name                 String
  slug                 String
  address              String
  timezone             String   @default("America/Bogota")
  phone_whatsapp_e164  String
  operating_hours_json Json     @default("[]")
  status               String   @default("ACTIVE") // ACTIVE | ARCHIVED
  created_at           DateTime @default(now()) @db.Timestamptz

  tenant           Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  channel_policies BranchChannelPolicy[]
  module_settings  TenantModuleSetting[]
  audit_events     AuditEvent[]
  menus                  Menu[]
  qr_code_links          QrCodeLink[]
  delivery_zones         DeliveryZone[]
  branch_order_sequences BranchOrderSequence[]
  orders                 Order[]

  @@unique([tenant_id, slug])
  @@map("branches")
}

// -----------------------------------------------------------------------------
// 2. IDENTIDAD, ROLES Y MEMBRESÍAS
// -----------------------------------------------------------------------------

model User {
  id                         String    @id @default(uuid()) @db.Uuid
  email                      String    @unique
  password_hash              String
  phone                      String
  name                       String
  status                     String    @default("ACTIVE") // ACTIVE | INVITED | SUSPENDED
  mfa_enabled                Boolean   @default(false)
  must_change_password       Boolean   @default(false)
  invite_or_reset_token_hash String?   @db.VarChar(128)
  invite_or_reset_expires_at DateTime? @db.Timestamptz
  created_at                 DateTime  @default(now()) @db.Timestamptz

  memberships  Membership[]
  audit_events AuditEvent[]

  @@map("users")
}

model Role {
  key  String @id @db.VarChar(64)
  name String

  permissions RolePermission[]
  memberships Membership[]

  @@map("roles")
}

model Permission {
  key         String @id @db.VarChar(64)
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_key       String @db.VarChar(64)
  permission_key String @db.VarChar(64)

  role       Role       @relation(fields: [role_key], references: [key], onDelete: Cascade)
  permission Permission @relation(fields: [permission_key], references: [key], onDelete: Cascade)

  @@id([role_key, permission_key])
  @@map("role_permissions")
}

model Membership {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  user_id      String   @db.Uuid
  role_key     String   @db.VarChar(64)
  branch_scope String[] @default([]) // Array de UUID de sucursales autorizadas (vacío o null autoriza todas)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [role_key], references: [key], onDelete: Restrict)

  @@unique([tenant_id, user_id, role_key])
  @@map("memberships")
}

// -----------------------------------------------------------------------------
// 3. CAPACIDADES MODULARES Y POLÍTICAS DE CANAL
// -----------------------------------------------------------------------------

model Module {
  key            String   @id @db.VarChar(64)
  name           String
  depends_on_all String[] @default([])
  depends_on_any String[] @default([])
  is_core        Boolean  @default(false)
  is_post_mvp    Boolean  @default(false)

  entitlements    PlanEntitlement[]
  tenant_settings TenantModuleSetting[]

  @@map("modules")
}

model PlanEntitlement {
  plan_id     String @db.VarChar(64)
  module_key  String @db.VarChar(64)
  limits_json Json   @default("{}")

  module Module @relation(fields: [module_key], references: [key], onDelete: Cascade)

  @@id([plan_id, module_key])
  @@map("plan_entitlements")
}

model TenantModuleSetting {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  branch_id  String?  @db.Uuid
  module_key String   @db.VarChar(64)
  enabled    Boolean  @default(true)
  config_json Json    @default("{}")
  updated_by String?  @db.Uuid
  updated_at DateTime @updatedAt @db.Timestamptz

  tenant Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  module Module  @relation(fields: [module_key], references: [key], onDelete: Restrict)

  @@unique([tenant_id, branch_id, module_key])
  @@map("tenant_module_settings")
}

model OperatingProfile {
  key                            String   @id @db.VarChar(64)
  name                           String
  module_keys                    String[] @default([])
  default_pickup_delivery_policy String   @default("NONE") // NONE | OFFLINE_ONLY
  default_config_json            Json     @default("{}")

  @@map("operating_profiles")
}

model BranchChannelPolicy {
  id                                 String   @id @default(uuid()) @db.Uuid
  tenant_id                          String   @db.Uuid
  branch_id                          String   @db.Uuid
  fulfillment_type                   String   @db.VarChar(32) // PICKUP | DELIVERY | DINE_IN
  enabled                            Boolean  @default(true)
  payment_policy                     String   @default("NONE") @db.VarChar(32) // NONE | OFFLINE_ONLY
  require_payment_before_preparation Boolean  @default(false)
  payment_instructions_json          Json?
  active_status_flow                 String[] @default([])
  tracking_enabled                   Boolean  @default(true)
  whatsapp_number_e164               String?  @db.VarChar(32)
  require_table_pin                  Boolean  @default(false)
  unprocessed_expiry_minutes         Int      @default(240)

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, branch_id, fulfillment_type])
  @@map("branch_channel_policies")
}

// -----------------------------------------------------------------------------
// 4. AUDITORÍA (SIN PII NI SECRETOS)
// -----------------------------------------------------------------------------

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  branch_id     String?  @db.Uuid
  actor_id      String?  @db.Uuid
  action        String   @db.VarChar(128)
  entity_type   String   @db.VarChar(64)
  entity_id     String   @db.VarChar(128)
  occurred_at   DateTime @default(now()) @db.Timestamptz
  metadata_json Json     @default("{}")

  tenant Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, occurred_at(sort: Desc)])
  @@map("audit_events")
}

// -----------------------------------------------------------------------------
// 5. CATÁLOGO DIGITAL, PRODUCTOS, MODIFICADORES Y CÓDIGOS QR
// -----------------------------------------------------------------------------

model Menu {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  branch_id  String?  @db.Uuid
  name       String
  status     String   @default("ACTIVE") // ACTIVE | ARCHIVED
  created_at DateTime @default(now()) @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  categories Category[]

  @@index([tenant_id, branch_id, status])
  @@map("menus")
}

model Category {
  id                         String   @id @default(uuid()) @db.Uuid
  tenant_id                  String   @db.Uuid
  menu_id                    String   @db.Uuid
  name                       String
  description                String?
  sort_order                 Int      @default(0)
  default_station_key        String?  @db.VarChar(50)
  availability_schedule_json Json?
  is_active                  Boolean  @default(true)

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  menu     Menu      @relation(fields: [menu_id], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenant_id, menu_id, sort_order])
  @@map("categories")
}

model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  tenant_id            String   @db.Uuid
  category_id          String   @db.Uuid
  name                 String
  description          String?
  image_url            String?
  price_cop            Int
  tax_type             String   @default("NONE") // NONE | INC | IVA | EXEMPT
  tax_rate_bp          Int      @default(0)
  override_station_key String?  @db.VarChar(50)
  allergen_tags        String[] @default([])
  status               String   @default("ACTIVE") // ACTIVE | OUT_OF_STOCK | ARCHIVED
  sort_order           Int      @default(0)
  created_at           DateTime @default(now()) @db.Timestamptz
  updated_at           DateTime @updatedAt @db.Timestamptz

  tenant          Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category        Category               @relation(fields: [category_id], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  modifier_groups ProductModifierGroup[]
  order_items     OrderItem[]

  @@index([tenant_id, category_id, status, sort_order])
  @@map("products")
}

model ProductVariant {
  id         String @id @default(uuid()) @db.Uuid
  tenant_id  String @db.Uuid
  product_id String @db.Uuid
  name       String
  price_cop  Int
  status     String @default("ACTIVE") // ACTIVE | OUT_OF_STOCK
  sort_order Int    @default(0)

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, product_id, sort_order])
  @@map("product_variants")
}

model ModifierGroup {
  id             String  @id @default(uuid()) @db.Uuid
  tenant_id      String  @db.Uuid
  name           String
  min_selections Int     @default(0)
  max_selections Int     @default(1)
  is_required    Boolean @default(false)

  tenant   Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  options  ModifierOption[]
  products ProductModifierGroup[]

  @@index([tenant_id, name])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String @id @default(uuid()) @db.Uuid
  tenant_id       String @db.Uuid
  group_id        String @db.Uuid
  name            String
  extra_price_cop Int    @default(0)
  status          String @default("ACTIVE") // ACTIVE | OUT_OF_STOCK
  sort_order      Int    @default(0)

  tenant Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  group  ModifierGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, group_id, sort_order])
  @@map("modifier_options")
}

model ProductModifierGroup {
  product_id String @db.Uuid
  group_id   String @db.Uuid
  sort_order Int    @default(0)

  product Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@id([product_id, group_id])
  @@map("product_modifier_groups")
}

model QrCodeLink {
  id          String    @id @default(uuid()) @db.Uuid
  tenant_id   String    @db.Uuid
  branch_id   String    @db.Uuid
  qr_token    String    @unique @db.VarChar(64)
  target_type String    @db.VarChar(32) // GENERAL_MENU | BRANCH_MENU | DINING_TABLE
  table_id    String?   @db.Uuid
  label       String    @db.VarChar(128)
  is_active   Boolean   @default(true)
  revoked_at  DateTime? @db.Timestamptz
  created_at  DateTime  @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, branch_id, is_active])
  @@map("qr_code_links")
}

// -----------------------------------------------------------------------------
// 5. MOTOR DE PEDIDOS, COBERTURA, ANTIFRAUDE Y LEY 1581 (FASE 03A)
// -----------------------------------------------------------------------------

model Customer {
  id                 String    @id @default(uuid()) @db.Uuid
  tenant_id          String    @db.Uuid
  name               String    @db.VarChar(150)
  phone_e164         String    @db.VarChar(48)
  privacy_consent_at DateTime  @db.Timestamptz(6)
  is_blocked         Boolean   @default(false)
  blocked_reason     String?   @db.Text
  blocked_at         DateTime? @db.Timestamptz(6)
  blocked_phone_hmac String?   @db.VarChar(64)
  anonymized_at      DateTime? @db.Timestamptz(6)
  last_order_at      DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)

  tenant             Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  addresses          DeliveryAddress[]
  orders             Order[]

  @@unique([tenant_id, phone_e164], name: "uq_customers_tenant_phone")
  @@index([tenant_id, is_blocked], name: "idx_customers_tenant_blocked")
  @@map("customers")
}

model DeliveryZone {
  id                            String   @id @default(uuid()) @db.Uuid
  tenant_id                     String   @db.Uuid
  branch_id                     String   @db.Uuid
  name                          String   @db.VarChar(120)
  polygon_or_neighborhoods_json Json     @db.JsonB
  delivery_fee_cop              Int      @default(0)
  min_order_cop                 Int      @default(0)
  estimated_minutes_min         Int      @default(30)
  estimated_minutes_max         Int      @default(50)
  is_active                     Boolean  @default(true)
  created_at                    DateTime @default(now()) @db.Timestamptz(6)

  tenant                        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch                        Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, branch_id, is_active], name: "idx_delivery_zones_branch_active")
  @@map("delivery_zones")
}

model DeliveryAddress {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  customer_id     String?  @db.Uuid
  address_line    String   @db.VarChar(255)
  neighborhood    String   @db.VarChar(120)
  reference_notes String?  @db.Text
  city            String   @default("Colombia") @db.VarChar(100)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  tenant          Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, customer_id], name: "idx_delivery_addresses_customer")
  @@map("delivery_addresses")
}

model BranchOrderSequence {
  tenant_id     String   @db.Uuid
  branch_id     String   @db.Uuid
  sequence_date String   @db.VarChar(10) // Formato YYYY-MM-DD en la zona horaria de la sucursal
  last_value    Int      @default(100)   // Inicia en 100 para que el primer pedido del día sea #A101

  tenant        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@id([tenant_id, branch_id, sequence_date])
  @@map("branch_order_sequences")
}

model Order {
  id                                 String    @id @default(uuid()) @db.Uuid
  tenant_id                          String    @db.Uuid
  branch_id                          String    @db.Uuid
  order_code                         String    @db.VarChar(16)
  origin                             String    @db.VarChar(24)
  fulfillment_type                   String    @db.VarChar(24)
  status                             String    @db.VarChar(32)
  payment_policy                     String    @db.VarChar(24)
  require_payment_before_preparation Boolean   @default(false)
  payment_status                     String    @db.VarChar(24)
  customer_id                        String?   @db.Uuid
  customer_snapshot_json             Json      @db.JsonB
  table_id                           String?   @db.Uuid
  dining_account_id                  String?   @db.Uuid
  public_token                       String    @unique @db.VarChar(64)
  public_token_expires_at            DateTime? @db.Timestamptz(6)
  idempotency_key                    String?   @db.VarChar(64)
  subtotal_products_cop              Int
  discount_total_cop                 Int       @default(0)
  delivery_fee_cop                   Int       @default(0)
  tax_total_cop                      Int       @default(0)
  tip_cop                            Int       @default(0)
  grand_total_cop                    Int
  paid_total_cop                     Int       @default(0)
  uncollected_amount_cop             Int       @default(0)
  resolution_type                    String?   @db.VarChar(24)
  resolution_reason                  String?   @db.Text
  resolved_by                        String?   @db.Uuid
  resolved_at                        DateTime? @db.Timestamptz(6)
  tax_summary_snapshot_json          Json      @db.JsonB
  notes                              String?   @db.Text
  is_locked                          Boolean   @default(false)
  processed_at                       DateTime? @db.Timestamptz(6)
  processed_by                       String?   @db.Uuid
  created_at                         DateTime  @default(now()) @db.Timestamptz(6)

  tenant                             Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch                             Branch             @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  customer                           Customer?          @relation(fields: [customer_id], references: [id])
  items                              OrderItem[]
  status_events                      OrderStatusEvent[]

  @@unique([tenant_id, idempotency_key], name: "uq_orders_tenant_idempotency")
  @@index([tenant_id, branch_id, status, created_at(sort: Desc)], name: "idx_orders_panel")
  @@index([tenant_id, customer_id, status], name: "idx_orders_customer_active")
  @@map("orders")
}

model OrderItem {
  id                      String   @id @default(uuid()) @db.Uuid
  tenant_id               String   @db.Uuid
  order_id                String   @db.Uuid
  product_id              String?  @db.Uuid
  product_snapshot_json   Json     @db.JsonB
  quantity                Int
  unit_price_cop          Int
  discount_cop            Int      @default(0)
  modifiers_snapshot_json Json     @db.JsonB
  tax_snapshot_json       Json     @db.JsonB
  line_total_cop          Int
  station_key             String?  @db.VarChar(48)
  status                  String   @default("PENDING") @db.VarChar(24)
  notes                   String?  @db.Text

  tenant                  Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  order                   Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product                 Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, order_id], name: "idx_order_items_order")
  @@map("order_items")
}

model OrderStatusEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  order_id            String   @db.Uuid
  from_status         String?  @db.VarChar(32)
  to_status           String   @db.VarChar(32)
  actor_id            String?  @db.Uuid
  occurred_at         DateTime @default(now()) @db.Timestamptz(6)
  reason              String?  @db.Text
  visible_to_customer Boolean  @default(true)

  tenant              Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  order               Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, order_id, occurred_at], name: "idx_order_status_events_order")
  @@map("order_status_events")
}

