# ==============================================================================
# Restaurante SaaS - Variables de Entorno Globales / Local
# ==============================================================================

# Entorno y Puertos
NODE_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Base de Datos PostgreSQL 16 / 17
# Cuenta de ejecución de la aplicación (app_runtime) con NOBYPASSRLS estricto:
DATABASE_URL="postgresql://restaurante_app:restaurante_pass@localhost:5432/restaurante_saas?schema=public"
# Cuenta administradora para aplicar migraciones DDL:
DATABASE_MIGRATION_URL="postgresql://restaurante_owner:restaurante_owner_pass@localhost:5432/restaurante_saas?schema=public"

# Seguridad JWT y Cookies
JWT_ACCESS_SECRET="cambiar_por_secreto_aleatorio_de_64_bytes_hex_acceso_desarrollo"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambiar_por_secreto_aleatorio_de_64_bytes_hex_refresco_desarrollo"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="cambiar_por_secreto_aleatorio_para_cookies_httponly_desarrollo"

# Secreto del Servidor para HMAC Antifraude (Ley 1581)
FRAUD_PEPPER_SECRET="cambiar_por_secreto_256_bits_exclusivo_servidor_hmac_antifraude"

# Transporte de Correo Transaccional de Sistema (Solo para forgot-password de TENANT_ADMIN)
SYSTEM_SMTP_HOST="localhost"
SYSTEM_SMTP_PORT=1025
SYSTEM_SMTP_FROM="no-reply@restaurantesaas.co"

# Frontend Vite
VITE_API_BASE_URL="http://localhost:4000/api/v1"
VITE_APP_NAME="Restaurante SaaS"
